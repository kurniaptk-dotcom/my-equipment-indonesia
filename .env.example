DATABASE_URL=postgresql://cms:local-cms-password@localhost:5432/myequipment
SITE_URL=https://www.myequipmentindonesia.com
# For local public-site preview without PostgreSQL; ignored in production.
USE_LOCAL_SEED_CONTENT=false
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_SIZE=10
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000
CMS_PUBLIC_URL=http://localhost:3000
CMS_BOOTSTRAP_NAME=My Equipment Admin
CMS_BOOTSTRAP_EMAIL=admin@example.com
CMS_BOOTSTRAP_PASSWORD=replace-with-a-unique-password-min-12-chars
CMS_S3_ENDPOINT=http://localhost:9000
CMS_S3_REGION=us-east-1
CMS_S3_BUCKET=myequipment-media
CMS_S3_ACCESS_KEY=local-cms
CMS_S3_SECRET_KEY=local-cms-minio-password
CMS_MEDIA_PUBLIC_URL=http://localhost:9000/myequipment-media
